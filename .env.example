# .env.example をコピーして .env を作り、値を入れてください(.env は Git に含めない)
# Gmail で送る場合は、2段階認証を有効にしたアカウントで「アプリパスワード」を発行して使う
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=送信用アドレス@gmail.com
EMAIL_HOST_PASSWORD=アプリパスワード(16桁)
DEFAULT_FROM_EMAIL=suki-match <送信用アドレス@gmail.com>

# メールに載せるドメイン(本番のドメインに変える)
SITE_DOMAIN=localhost:8000

# Googleログイン(Google Cloud Console の OAuth クライアント)
# 承認済みのリダイレクトURI: http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Maps(Maps JavaScript API と Geocoding API を有効にしたAPIキー)
# 未設定なら OpenStreetMap + 国土地理院の住所検索で動く
GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# ACCOUNT_EMAIL_VERIFICATION=mandatory
