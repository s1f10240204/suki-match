# .env.example をコピーして .env を作り、値を入れてください(.env は Git に含めない)
# Gmail で送る場合は、2段階認証を有効にしたアカウントで「アプリパスワード」を発行して使う
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=送信用アドレス@gmail.com
EMAIL_HOST_PASSWORD=アプリパスワード(16桁)
DEFAULT_FROM_EMAIL=Suki-match <送信用アドレス@gmail.com>

# 任意
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ACCOUNT_EMAIL_VERIFICATION=mandatory
